<?xml version="1.0" encoding="UTF-8"?>

<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_5_0.xsd"
         version="5.0"
         metadata-complete="true">

    <!-- Register -->
    <servlet>
        <servlet-name>RegisterServlet</servlet-name>
        <servlet-class>com.publicsafety.RegisterServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RegisterServlet</servlet-name>
        <url-pattern>/register</url-pattern>
    </servlet-mapping>

    <!-- Login -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>com.publicsafety.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <!-- Logout -->
    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>com.publicsafety.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/LogoutServlet</url-pattern>
    </servlet-mapping>

    <!-- Emergency Contact -->
    <servlet>
        <servlet-name>EmergencyContactServlet</servlet-name>
        <servlet-class>com.publicsafety.EmergencyContactServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>EmergencyContactServlet</servlet-name>
        <url-pattern>/EmergencyContactServlet</url-pattern>
    </servlet-mapping>

    <!-- Medication -->
    <servlet>
        <servlet-name>MedicationServlet</servlet-name>
        <servlet-class>com.publicsafety.MedicationServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>MedicationServlet</servlet-name>
        <url-pattern>/MedicationServlet</url-pattern>
    </servlet-mapping>

    <!-- Health Checkin -->
    <servlet>
        <servlet-name>HealthCheckinServlet</servlet-name>
        <servlet-class>com.publicsafety.HealthCheckinServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>HealthCheckinServlet</servlet-name>
        <url-pattern>/HealthCheckinServlet</url-pattern>
    </servlet-mapping>

    <!-- Incident Report -->
    <servlet>
        <servlet-name>IncidentReportServlet</servlet-name>
        <servlet-class>com.publicsafety.IncidentReportServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>IncidentReportServlet</servlet-name>
        <url-pattern>/IncidentReportServlet</url-pattern>
    </servlet-mapping>

    <!-- Save Contact -->
    <servlet>
        <servlet-name>SaveContactServlet</servlet-name>
        <servlet-class>com.publicsafety.SaveContactServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SaveContactServlet</servlet-name>
        <url-pattern>/SaveContactServlet</url-pattern>
    </servlet-mapping>

    <!-- SOS -->
    <servlet>
        <servlet-name>SOSServlet</servlet-name>
        <servlet-class>com.publicsafety.SOSServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SOSServlet</servlet-name>
        <url-pattern>/SOSServlet</url-pattern>
    </servlet-mapping>

</web-app>